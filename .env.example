# Copy to .env and adjust. Placeholders only: no secrets are needed to run the app locally.

# Path to the SQLite database file, relative to api/. Parent directory is created on first start.
TODO_DB_PATH=./data/todo.db

# Session cookie Secure flag. Keep false for local http://localhost runs.
TODO_COOKIE_SECURE=false

# Port the API listens on.
SERVER_PORT=8080
