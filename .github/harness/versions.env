# Tool versions for the runner images and copilot-setup-steps.yml (SDD 08 §1, ADR-0010, NFR-011).
# The single source: docker/scripts/install-tools.sh reads it, docker/build.sh passes the images to the Dockerfile,
# and docker/tools.json names each pin's version check and licence. Bump a pin here and run docker/test/smoke.sh.
# Pinned 2026-11-01 (M07a spike, docs/spikes/M07.md).

# Base image and the Ubuntu archive snapshot every apt package is installed from (apt --snapshot).
UBUNTU_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
UBUNTU_SNAPSHOT=20261030T000000Z

# Compose services (docker/compose/compose.yaml). LiteLLM and Postgres as verified in the M06 spike.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.104.3@sha256:c1909418aea76c798222f701ccd27a1b963d8cf713f797fa072fd222a6a774a4
POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
# The egress proxy and the OpenTelemetry collector (M07b). The code-intel service runs the runner image (Q19).
SQUID_IMAGE=ubuntu/squid:6.6-24.04_edge@sha256:8a3baed477e2c282ab8aa5edad442f69873246964f225c5c2ae8364b6610963c
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:0.162.0@sha256:310a800ad69ee430e7c541796852a242c9c7db97aaad4daa5ccf843c525fbdb2
# The observability profile (M07e): Grafana, Tempo, Loki; pinned 2026-11-01, each release at least two weeks old
# (Grafana 13.2.4 2026-10-13, Tempo 3.0.4 2026-10-16, Loki 3.7.8 2026-09-17).
GRAFANA_IMAGE=grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f
TEMPO_IMAGE=grafana/tempo:3.0.4@sha256:dbd8ef9b596aa0efb6c2f9cefc94efa3a2d92d3b4242c250e6f9d98354dec4a4
LOKI_IMAGE=grafana/loki:3.7.8@sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
# The gateway-hosted MCP servers' stubs (M15): a pinned busybox until the real images are pinned (M15b).
MCP_AWS_IMAGE=busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
MCP_AZURE_IMAGE=busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
# Dex, the test identity provider for harness login (M15); v2.46.0 released 2026-10-07.
DEX_IMAGE=dexidp/dex:v2.46.0@sha256:933fcd3f523338c847b88ef84a7145fb2fcb7b9917f08418612afeaaa2001777
# The audit store (M13, SDD 10 §3, Q-03), in the observability profile; pinned 2026-11-01. The collector's contrib build,
# for its S3 exporter, at the core collector's version. MinIO's own images are no longer published (Docker Hub and Quay
# list none; github.com/minio/minio is archived, last tag RELEASE.2025-10-15T17-29-55Z), so the store and its client
# are Silo and mcli, the community fork Pigsty publishes from github.com/pgsty/minio and github.com/pgsty/mc (AGPL-3.0,
# as MinIO), pinned by index digest; local tests only, never production (docs/spikes/M13.md §3, choice 3).
OTEL_COLLECTOR_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
AUDIT_STORE_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
AUDIT_STORE_MC_IMAGE=pgsty/mc:RELEASE.2026-10-18T00-00-00Z@sha256:6ecdaec70bc5e8cf9d0e9a70c190f3beb1c83f11617ff4333f1fcd71ab1daf18
# The OKF viewer's static file server (M08): busybox httpd, the same pinned image as the MCP stubs.
OKF_VIEWER_IMAGE=busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478

# apt packages, from the snapshot above
GIT_VERSION=1:2.43.0-1ubuntu7.4
PYTHON_VERSION=3.12.3-1ubuntu0.17
XVFB_VERSION=2:21.1.12-1ubuntu1.9
UNIVERSAL_CTAGS_VERSION=5.9.20210829.0-1
# GnuCOBOL (M12): compiles legacy COBOL for the characterisation suite's legacy adapter (noble universe).
GNUCOBOL_VERSION=3.1.2-5.1ubuntu1

# Languages and build tools
NODE_VERSION=22.23.4
PNPM_VERSION=10.34.8
TEMURIN_VERSION=21.0.13+9
MAVEN_VERSION=3.9.16
GRADLE_VERSION=9.8.2
DOTNET_SDK_8_VERSION=8.0.427
DOTNET_SDK_10_VERSION=10.0.403

# Agents and GitHub
CLAUDE_CODE_VERSION=2.1.316
COPILOT_CLI_VERSION=1.0.105
GH_VERSION=2.103.3

# Built from this repository (docker/runner/Dockerfile's harness-build stage, not install-tools.sh): the code-intel MCP
# server, at the version the registry pins (governance/mcp-registry.yaml) and its serverInfo reports (Q19).
CODE_INTEL_MCP_VERSION=0.1.0

# Browsers and diagrams
PLAYWRIGHT_VERSION=1.64.1
DRAWIO_VERSION=32.6.1

# Security and analysis
SEMGREP_VERSION=1.183.0
