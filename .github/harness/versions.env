TREE_SITTER_SHA256_ARM64=404be5d54a4955571c4067c21d4699660eab3a534cefb0659341b207f7139ec5
SQLGLOT_VERSION=30.27.0

# Optional layer (reverseEngineering.codeql, Q-05): runner-core-codeql
CODEQL_VERSION=2.27.3

