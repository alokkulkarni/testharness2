    ".harness/changes/<change-id>/evidence/characterisation/",
    ".harness/changes/<change-id>/evidence/equivalence/",
    ".harness/changes/<change-id>/evidence/recipe/"
  ],
  "servers": {
    "atlassian": {
      "scopeDimensions": [
        "projects",
        "confluenceSpaces"
      ]
    },
    "aws": {
      "scopeDimensions": [
        "accounts"
      ]
    },
    "azure": {
      "scopeDimensions": [
        "subscriptions"
      ]
    },
    "code-intel": {
      "scopeDimensions": []
    },
    "feature-flags": {
      "scopeDimensions": []
    },
    "figma": {
      "scopeDimensions": []
    },
    "github": {
      "scopeDimensions": [
        "repos"
      ]
    },
    "model-tasks": {
      "scopeDimensions": []
    },
    "playwright": {
      "scopeDimensions": []
    },
    "snyk": {
      "scopeDimensions": []
    }
