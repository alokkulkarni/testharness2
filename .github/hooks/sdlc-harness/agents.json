  "agents": {
    "backend-qa": {
      "plugin": "sdlc-quality",
      "role": "tester",
      "bashAllow": [
        "./mvnw ",
        "mvn ",
        "./gradlew ",
        "gradle ",
        "dotnet ",
        "pnpm ",
        "npm ",
        "npx ",
        "docker compose ",
        "git ",
        "harness plan status",
        "harness evidence attach",
        "harness gate record"
      ],
      "produces": [
        "tests-red-first"
      ],
      "mcp": [],
      "outputs": []
    },
    "characterisation-tester": {
      "plugin": "sdlc-modernise",
      "role": "tester",
      "bashAllow": [
        "harness characterise run",
        "harness characterise diff",
        "harness evidence attach",
        "harness gate record",
        "harness plan status",
        "mvn ",
        "dotnet ",
        "git "
      ],
      "produces": [
        "characterisation-green",
        "equivalence"
      ],
      "mcp": [],
      "outputs": [
        "tests/characterisation/**",
        ".harness/changes/<change-id>/evidence/equivalence-diff/",
        ".harness/changes/<change-id>/evidence/parallel-run-plan/",
        "docs/migration/parallel-run-plan.md"
      ]
    },
    "critic": {
