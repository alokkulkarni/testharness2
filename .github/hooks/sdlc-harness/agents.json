    "sdlc-backend",
    "sdlc-core",
    "sdlc-design",
    "sdlc-docs",
    "sdlc-governance",
    "sdlc-mobile",
    "sdlc-modernise",
    "sdlc-platform",
    "sdlc-quality",
    "sdlc-release",
    "sdlc-reverse",
    "sdlc-web"
  ],
  "harnessProducts": [
    ".harness/re/inventory.json",
    ".harness/re/history.json",
    ".harness/re/coverage.json",
    ".harness/re/graph.jsonl",
    ".harness/re/deps/*.json",
    ".harness/re/rules/candidates.json",
    ".harness/re/ui/figma-frames.json",
    ".harness/re/ui/catalogue/index.html",
