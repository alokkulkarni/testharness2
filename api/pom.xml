<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Minimal build written by the tests node (N07-tests-backend): what the red run needs to compile and run the
       tests. A single module (NFR-007 AC-1, no <modules>). The java-engineer (N09) pins the exact Spring Boot 4.x
       line (sdd.md section 12.1 item 21) and extends this file with what the production code needs. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>app.todo</groupId>
  <artifactId>todo-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>todo-api</name>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.1</archunit.version>
    <openapi-request-validator.version>3.0.0</openapi-request-validator.version>
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
  </properties>

  <dependencies>
    <!-- Embedded container: the integration tests start the application at a random port. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Tests: JUnit 5, AssertJ, Mockito, JsonPath, Spring Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Contract validator (ADR-0012), core v3 line -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-core</artifactId>
      <version>${openapi-request-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Architecture rules (ADR-0018) -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The tests read the SQLite file (Db) and name HikariDataSource (ModuleWiringTest, architecture fixture) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
