<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Build started by the tests node (N07-tests-backend) and extended by the java-engineer (N09) with what the
       production code needs. A single module (NFR-007 AC-1, no <modules>).
       Spring Boot pin (sdd.md section 12.1 item 21, clarifications Q60): 4.1.2 is the latest Spring Boot 4.x release
       that resolves from Maven Central (4.1.3 and 4.2.0 do not, checked 2026-11-09); it is pinned exactly here. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>app.todo</groupId>
  <artifactId>todo-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>todo-api</name>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.1</archunit.version>
    <openapi-request-validator.version>3.0.0</openapi-request-validator.version>
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
    <bouncycastle.version>1.85</bouncycastle.version>
  </properties>

  <dependencies>
    <!-- Web MVC (ADR-0002) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Spring Security: stateless filter chain, request firewall, Argon2 encoder (ADR-0004, ADR-0005, ADR-0011) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- JdbcClient and one HikariCP pool, no JPA (ADR-0009, ADR-0016) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Flyway migrations at start-up (ADR-0014) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- SQLite driver (ADR-0003) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <!-- Argon2id needs BouncyCastle (ADR-0005) -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- Tests: JUnit 5, AssertJ, Mockito, JsonPath, Spring Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MockMvc for the integration level (sdd.md section 14): auto-configured MockMvc in Spring Boot 4 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Contract validator (ADR-0012), core v3 line and its v3 MockMvc adapter -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-core</artifactId>
      <version>${openapi-request-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-mockmvc</artifactId>
      <version>${openapi-request-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Architecture rules (ADR-0018) -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- spring-boot:run and spring-boot:test-run (sdd.md section 11, ADR-0013); version from the parent -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
