<mxfile host="sdlc-harness">
  <diagram id="seq-todo-crud-list" name="Sequence create edit list">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2300" pageHeight="1500">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Sequence: create, edit and list with search, filter and pagination&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: REQ-TODO-001, REQ-TODO-002, REQ-TODO-003 AC-1, REQ-TODO-004, REQ-LIST-001..003, REQ-ISO-001, REQ-DATA-002, NFR-007; sdd §2, §5, §7; ADR-0006, 0009, 0010, 0013, 0015, 0016, 0017, 0018; todo-api-v1.yaml createTodo, updateTodo, listTodos" style="text;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="SPA [browser]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=80;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="160" height="1260" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="SessionCookieAuthenticationFilter + ClientHeaderFilter + TodoController [auth, common, todo]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=80;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="280" height="1260" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="TodoService (+ TodoValidator, Clock) [todo]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=80;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="100" width="200" height="1260" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="TodoRepository [todo]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=80;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1610" y="100" width="180" height="1260" as="geometry"/>
        </mxCell>
        <mxCell id="L5" value="SQLite file" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=80;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="2070" y="100" width="160" height="1260" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="1. POST /api/v1/todos + cookie todo_session +&lt;br&gt;X-Todo-Client: web [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1111;entryX=0.5;entryY=0.1111;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="2. session valid, header ok; CurrentUser(userId)&lt;br&gt;principal from the session filter; create(userId,&lt;br&gt;body), validate fields [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1786;entryX=0.5;entryY=0.1786;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="3. insert(userId, NewTodo); created_at =&lt;br&gt;updated_at = Clock now [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2341;entryX=0.5;entryY=0.2341;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="4. INSERT todos (public_id UUID v4,&lt;br&gt;title_search lower-cased) [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2897;entryX=0.5;entryY=0.2897;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. 201 Todo (priority defaults MEDIUM); invalid:&lt;br&gt;400 VALIDATION_FAILED with all field errors&lt;br&gt;[HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.3571;entryX=0.5;entryY=0.3571;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="6. PUT /api/v1/todos/{todoId} whole content:&lt;br&gt;title, description, dueDate, priority [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4127;entryX=0.5;entryY=0.4127;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="7. update(userId, todoId, body) after the&lt;br&gt;same checks [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4683;entryX=0.5;entryY=0.4683;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m8" value="8. updateContent(..., updatedAt =&lt;br&gt;max(now, previous + 1 ms)) [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5238;entryX=0.5;entryY=0.5238;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m9" value="9. UPDATE todos WHERE public_id = ? AND&lt;br&gt;user_id = ?; last write wins [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5794;entryX=0.5;entryY=0.5794;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m10" value="10. 200 Todo; zero rows changed (missing, malformed&lt;br&gt;or another user's id): same 404 NOT_FOUND&lt;br&gt;[HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.6468;entryX=0.5;entryY=0.6468;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m11" value="11. GET /api/v1/todos?status=&amp;amp;q=&amp;amp;page=&lt;br&gt;(URL query is the list state) [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7024;entryX=0.5;entryY=0.7024;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m12" value="12. list(userId, TodoQuery): q trimmed,&lt;br&gt;page validated [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7579;entryX=0.5;entryY=0.7579;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m13" value="13. list + totals(userId) in one read&lt;br&gt;transaction [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.8135;entryX=0.5;entryY=0.8135;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m14" value="14. SELECT: instr(title_search / description_search,&lt;br&gt;:q), done filter, ORDER BY created_at DESC, id DESC,&lt;br&gt;20 per page [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.881;entryX=0.5;entryY=0.881;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m15" value="15. 200 TodoPage {items, page clamped to last page,&lt;br&gt;totalPages, totals}; bad page: 400 [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.9365;entryX=0.5;entryY=0.9365;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Boxes at the top are participants (dark blue: container or datastore, light blue: components); vertical dashed line: lifeline. Brackets name the module package (sdd §2).&lt;br&gt;Solid arrow: request or call, numbered in order; dashed arrow: response. Labels end with the protocol or mechanism." style="text;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1410" width="1100" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
