        </mxCell>
        <mxCell id="advice" value="&lt;b&gt;ProblemDetailsAdvice&lt;/b&gt; [Spring MVC]&lt;br&gt;ApiException subtypes and MVC exceptions: 400, 404, 405, 409, 415, 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="160" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;ProblemAuthenticationEntryPoint&lt;/b&gt; [Spring Security]&lt;br&gt;401 UNAUTHENTICATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="340" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pw" value="&lt;b&gt;ProblemWriter&lt;/b&gt; [component]&lt;br&gt;Only builder of error bodies: application/problem+json with code and errors[] (ADR-0011)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="540" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rej" value="&lt;b&gt;ProblemRequestRejectedHandler&lt;/b&gt; [Spring Security]&lt;br&gt;Firewall rejections: REQUEST_REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="740" width="240" height="80" as="geometry"/>
        </mxCell>
