<mxfile host="sdlc-harness">
  <diagram id="c4-component-api" name="C4 component API modules">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2700" pageHeight="1700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · C4 component view · API modules (api/, root package app.todo)&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: NFR-007 AC-1..AC-3, REQ-ISO-001, REQ-AUTH-002 AC-4, REQ-AUTH-004 AC-1; sdd §2, §3, §4, §7, §10; ADR-0004, 0005, 0007..0010, 0013..0016, 0018; the error path is in c4-component-errors" style="text;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1700" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="Identity module · app.todo.auth · contract identity-api-v1.yaml · tables users, sessions" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="1700" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="common" value="Shared kernel · app.todo.common (not a module; error-path components: see c4-component-errors)" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=right;spacingRight=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="660" width="1700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="todo" value="To-dos module · app.todo.todo · contract todo-api-v1.yaml · table todos" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="900" width="1700" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="Composition root · app.todo.config and app.todo (not a module) · table flyway_schema_history" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="1280" width="1700" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;SPA&lt;/b&gt; [React, TypeScript]&lt;br&gt;Calls /api/v1/**" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="240" y="700" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite file&lt;/b&gt;&lt;br&gt;[one file, one pool]&lt;br&gt;users, sessions, todos, flyway_schema_history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="2400" y="150" width="200" height="1300" as="geometry"/>
        </mxCell>
        <mxCell id="cu" value="&lt;b&gt;auth.api · CurrentUser&lt;/b&gt; [published record]&lt;br&gt;CurrentUser(long userId): the only type auth publishes (ADR-0018)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="40" y="40" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="userrepo" value="&lt;b&gt;UserRepository&lt;/b&gt; [JdbcClient, package-private]&lt;br&gt;Find by identifier_key, findById, insert (ADR-0009, 0018)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="1000" y="40" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="authc" value="&lt;b&gt;AuthController&lt;/b&gt; [Spring MVC]&lt;br&gt;signUp, logIn, logOut, getSession" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="620" y="200" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="authsvc" value="&lt;b&gt;AuthService&lt;/b&gt; [Spring bean]&lt;br&gt;Trim, validate, Argon2id hash and verify, dummy hash for unknown user (ADR-0005)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="1000" y="200" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;PasswordRules, IdentifierRules&lt;/b&gt; [validators]&lt;br&gt;Password 8-128, identifier 3-254, email or username (sdd §5, ADR-0010)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="1380" y="200" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sessf" value="&lt;b&gt;SessionCookieAuthenticationFilter&lt;/b&gt; [Spring Security]&lt;br&gt;Hashes cookie token, loads session; sets CurrentUser principal or leaves request unauthenticated (ADR-0004, 0008)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="40" y="360" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sesssvc" value="&lt;b&gt;SessionService&lt;/b&gt; [Spring bean]&lt;br&gt;Create (SHA-256 of 256-bit token, 8 h absolute), resolve, delete (ADR-0004, 0008)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="1000" y="360" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sessrepo" value="&lt;b&gt;SessionRepository&lt;/b&gt; [JdbcClient, package-private]&lt;br&gt;Insert, find by token_hash, delete expired and on logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="auth">
          <mxGeometry x="1380" y="360" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="reqid" value="&lt;b&gt;RequestIdFilter&lt;/b&gt; [servlet filter]&lt;br&gt;Ahead of the security chain, REQUEST and ERROR dispatches: request id and the one per-request log line; 500 and stack trace if the chain throws (sdd §10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="common">
          <mxGeometry x="40" y="40" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hdrf" value="&lt;b&gt;ClientHeaderFilter&lt;/b&gt; [servlet filter]&lt;br&gt;POST, PUT, DELETE need X-Todo-Client: web, else 403; guards both modules (ADR-0007)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="common">
          <mxGeometry x="620" y="40" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="clock" value="&lt;b&gt;ClockConfig&lt;/b&gt; [Spring config]&lt;br&gt;Injected Clock, system UTC in the normal run (ADR-0013)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="common">
          <mxGeometry x="1000" y="40" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ws" value="&lt;b&gt;Whitespace&lt;/b&gt; [utility]&lt;br&gt;Unicode White_Space set of 25 code points: trim, isBlank (sdd §5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="common">
          <mxGeometry x="1380" y="40" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="todoc" value="&lt;b&gt;TodoController&lt;/b&gt; [Spring MVC]&lt;br&gt;list, get, create, update, setDone, delete, clearCompleted; TodoQuery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="todo">
          <mxGeometry x="620" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="todosvc" value="&lt;b&gt;TodoService&lt;/b&gt; [Spring bean]&lt;br&gt;Create, whole-content replace, done, delete, clamped paging, totals, clear completed (sdd §7, ADR-0006)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="todo">
          <mxGeometry x="1000" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="todoval" value="&lt;b&gt;TodoValidator&lt;/b&gt; [validator]&lt;br&gt;Title, description, strict due date, priority; all field errors together (sdd §5, ADR-0010)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="todo">
          <mxGeometry x="1380" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="todorepo" value="&lt;b&gt;TodoRepository&lt;/b&gt; [JdbcClient, package-private]&lt;br&gt;Every method takes userId; WHERE public_id AND user_id in one statement (ADR-0009)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="todo">
          <mxGeometry x="1000" y="210" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="secconf" value="&lt;b&gt;SecurityConfig&lt;/b&gt; [Spring config]&lt;br&gt;Names both modules' paths, wires the filter chain and registers RequestIdFilter (ADR-0018)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="config">
          <mxGeometry x="40" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dbconf" value="&lt;b&gt;DatabaseConfig&lt;/b&gt; [Spring config]&lt;br&gt;The only DataSource: HikariCP size 1, WAL, foreign_keys ON, Flyway (ADR-0014, 0016)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="config">
          <mxGeometry x="1000" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTP/JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spa" target="reqid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="next filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reqid" target="sessf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="then header check (401 before 403)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="sessf" target="hdrf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="640"/><mxPoint x="1180" y="640"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="routes /todos/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hdrf" target="todoc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="delegates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="authc" target="authsvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="delegates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="todoc" target="todosvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="validates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="authsvc" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="validates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="todosvc" target="todoval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="trims with" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="todoval" target="ws"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="creates, deletes sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="authsvc" target="sesssvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="users: find by key, insert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="authsvc" target="userrepo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12b" value="getSession: findById" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="authc" target="userrepo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="195"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="sessions [JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sesssvc" target="sessrepo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="to-dos [JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="todosvc" target="todorepo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="resolves session via" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sessf" target="sesssvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="routes /auth/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;jumpStyle=arc;jumpSize=12;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="hdrf" target="authc"><mxGeometry x="-0.1" relative="1" as="geometry"/></mxCell>
        <mxCell id="e16a" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.0346;" edge="1" parent="1" source="userrepo" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16b" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.2808;" edge="1" parent="1" source="sessrepo" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16c" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7808;" edge="1" parent="1" source="todorepo" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16d" value="Creates the only DataSource, runs Flyway [JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.95;" edge="1" parent="1" source="dbconf" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="uses Clock for timestamps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="todosvc" target="clock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="uses Clock for expiry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sesssvc" target="clock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ecu1" value="sets as Spring Security principal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sessf" target="cu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ecu2" value="reads with&lt;br&gt;@AuthenticationPrincipal;&lt;br&gt;passes userId on&lt;br&gt;(todo to auth.api,&lt;br&gt;allowed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="todoc" target="cu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1005"/><mxPoint x="100" y="195"/></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue box: component · Mid blue box: container · Cylinder: datastore · Dashed box: module package, shared kernel or composition root · Arrow: call or dependency, labelled with verb and mechanism.&lt;br&gt;Allowed dependencies, enforced by ArchUnit (NFR-007 AC-2, ADR-0018): todo uses todo, common, auth.api; auth uses auth, common; common uses no module and not config; config and the root package use any. Repositories are package-private.&lt;br&gt;Edges between the filters (next filter, then header check, routes) show runtime order, wired in config, not code dependencies. One DataSource, owned by config (NFR-007 AC-1). ApiException subtypes and the test-only classes are not drawn (sdd §2)." style="text;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1510" width="1600" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
