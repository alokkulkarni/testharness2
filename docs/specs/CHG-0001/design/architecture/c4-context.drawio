<mxfile host="sdlc-harness">
  <diagram id="c4-context" name="C4 context">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · C4 system context view&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (approved 2026-11-06) · drawn 2026-11-06&lt;br&gt;Traces: NFR-002, NFR-005, REQ-AUTH-005, sdd §1, §2, §11" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Signs up, logs in and manages only their own to-dos. One role, no admin (REQ-AUTH-005)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="todo" value="&lt;b&gt;To-do app&lt;/b&gt;&lt;br&gt;[Software system]&lt;br&gt;Web UI plus HTTP API plus SQLite file. Runs on the user's own machine (NFR-002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="860" y="260" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="none" value="&lt;b&gt;Not present (NFR-002)&lt;/b&gt;&lt;br&gt;No cloud service, hosted database, email service, identity provider or other network service. Nothing external is drawn because the spec has none." style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="860" y="460" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Uses [HTTP, web browser]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="user" target="todo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Dark blue box: person&lt;br&gt;Mid blue box: software system in scope&lt;br&gt;Dashed box: statement of absence&lt;br&gt;Arrow: call, labelled with verb and protocol" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="300" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
