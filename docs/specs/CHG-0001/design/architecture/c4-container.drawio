<mxfile host="sdlc-harness">
  <diagram id="c4-container" name="C4 container">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="640">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · C4 container view&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: sdd §2, §3, §11; ADR-0001, 0002, 0003, 0009, 0014, 0016, 0018; NFR-002, NFR-005, NFR-007, REQ-DATA-001; C-2" style="text;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="To-do app (software system) · user's machine only" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="1720" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Uses the to-do app in a browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="180" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;SPA&lt;/b&gt; [React, TypeScript, Vite; web/]&lt;br&gt;Screens, mirror validation, routing, a11y, session state (ADR-0001)" style="rounded=1;whiteSpace=wrap;html=1;spacingLeft=10;spacingRight=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="40" y="100" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Vite dev-server proxy&lt;/b&gt; [Vite, :5173]&lt;br&gt;Serves the SPA; forwards /api so both share one origin (ADR-0001)" style="rounded=1;whiteSpace=wrap;html=1;spacingLeft=10;spacingRight=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="480" y="100" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt; [Java 21, Spring Boot, JdbcClient; api/, :8080]&lt;br&gt;Modular monolith: identity (auth) and to-dos (todo) modules over a shared kernel; one process, one pool (NFR-007, ADR-0018). Sessions, validation, problem+json errors (ADR-0002, 0009, 0011)" style="rounded=1;whiteSpace=wrap;html=1;spacingLeft=10;spacingRight=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="920" y="65" width="400" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite file&lt;/b&gt;&lt;br&gt;[WAL; TODO_DB_PATH]&lt;br&gt;users, sessions, todos; Flyway (ADR-0003, 0014)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="1500" y="85" width="200" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Uses [HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Calls /api/v1/**&lt;br&gt;[HTTP/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spa" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Forwards /api&lt;br&gt;[HTTP/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proxy" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Reads, writes&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Dark blue: person · Mid blue box: container · Cylinder: datastore · Dashed box: system boundary · Arrow: call, labelled with verb and protocol&lt;br&gt;Cookie todo_session is HttpOnly, SameSite=Strict (ADR-0004). One pooled SQLite connection (ADR-0016). No CORS configured (ADR-0007)." style="text;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1100" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
