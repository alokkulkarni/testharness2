<mxfile host="sdlc-harness">
  <diagram id="screen-flow" name="Screen flow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · SPA route and screen flow&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec · drawn 2026-11-06 · Traces: sdd §4.1, §4.2, §8; REQ-AUTH-001, REQ-AUTH-002 AC-1 AC-4, REQ-AUTH-004 AC-2..AC-4, REQ-TODO-001..007; screen ids from design/ux/ux-design.md §2" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;Start: session probe&lt;/b&gt;&lt;br&gt;[SessionProvider, getSession once]&lt;br&gt;unknown, then signed-in or signed-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="signup" value="&lt;b&gt;/signup&lt;/b&gt; [public route, S1]&lt;br&gt;Sign-up form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="login" value="&lt;b&gt;/login&lt;/b&gt; [public route, S2]&lt;br&gt;Log-in form; messages come from router state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="list" value="&lt;b&gt;/todos?status=&amp;amp;q=&amp;amp;page=&lt;/b&gt; [RequireAuth, S3]&lt;br&gt;List, filter, search, pagination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="300" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="new" value="&lt;b&gt;/todos/new&lt;/b&gt; [RequireAuth, S4]&lt;br&gt;Add form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="detail" value="&lt;b&gt;/todos/:id&lt;/b&gt; [RequireAuth, S5]&lt;br&gt;Detail with timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="540" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="edit" value="&lt;b&gt;/todos/:id/edit&lt;/b&gt; [RequireAuth, S6]&lt;br&gt;Edit form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1560" y="540" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="del" value="&lt;b&gt;Delete dialog&lt;/b&gt; [native dialog, D1]&lt;br&gt;Names the to-do; Cancel changes nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1560" y="300" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="clear" value="&lt;b&gt;Clear-completed dialog&lt;/b&gt; [native dialog, D2]&lt;br&gt;Shows N and scope; control disabled when N = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1560" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="signed out, public route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="probe" target="signup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="signed out, to-do route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="probe" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="signed in: stays; /login and /signup go to /todos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.9;" edge="1" parent="1" source="probe" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="420"/><mxPoint x="1050" y="420"/><mxPoint x="1050" y="372"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="201: log in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="signup" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="200: safeReturnTo(returnTo), else /todos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="login" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Add a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="list" target="new"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6b" value="after create: /todos page 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="new" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Open a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="list" target="detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Edit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="detail" target="edit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Delete a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="list" target="del"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Clear completed (after totals re-fetch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="list" target="clear"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="401 while signed in: /login?returnTo= with session-ended message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="list" target="login"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1126" y="480"/><mxPoint x="668" y="480"/></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue box: route and screen (guard in brackets) · Yellow box: modal dialog · Grey box: start state · Arrow: navigation or event, labelled with condition&lt;br&gt;Signed-out visitor on a to-do route is replaced to /login?returnTo=path with no message; log out goes to /login with no message; the session-ended message applies to any 401 except the probe and logIn (sdd §4.1).&lt;br&gt;Screen ids S1..S6, D1, D2 are from design/ux/ux-design.md §2. The frozen sdd does not say where Save on edit navigates, so no such edge is drawn; the delete dialog also opens from the detail page per ux-design.md (not drawn)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1500" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
