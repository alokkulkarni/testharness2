<mxfile host="sdlc-harness">
  <diagram id="screen-flow" name="Screen flow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2300" pageHeight="1250">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · SPA route and screen flow&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: sdd §4.1, §4.2, §6.1, §8; REQ-AUTH-001, REQ-AUTH-002 AC-1 AC-4, REQ-AUTH-004 AC-2..AC-4, REQ-NAV-001, REQ-TODO-001..007, NFR-006 AC-1 AC-3; screen ids and the dashed edges from design/ux/ux-design.md §2 (not frozen)" style="text;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;Start: session probe&lt;/b&gt; [G1]&lt;br&gt;[SessionProvider, getSession once]&lt;br&gt;unknown, then signed-in or signed-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="240" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="pf" value="&lt;b&gt;Probe failed&lt;/b&gt; [G1 alert]&lt;br&gt;The app could not reach the server, with a Retry button; state stays unknown, never redirects (sdd §4.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="signup" value="&lt;b&gt;/signup&lt;/b&gt; [public route, S1]&lt;br&gt;Sign-up form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="login" value="&lt;b&gt;/login&lt;/b&gt; [public route, S2]&lt;br&gt;Log-in form; messages come from router state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="root" value="&lt;b&gt;/&lt;/b&gt; [route, no screen]&lt;br&gt;Replaced in history with /todos, query dropped (REQ-NAV-001 AC-1, AC-2)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="900" y="640" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="nf" value="&lt;b&gt;* (any other path)&lt;/b&gt; [RequireAuth, S7 NotFoundPage]&lt;br&gt;Signed in: not-found page with a link to /; never redirects (REQ-NAV-001 AC-3, AC-5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="480" y="820" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="anyscreen" value="&lt;b&gt;Any screen&lt;/b&gt;&lt;br&gt;An error is thrown while rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="1005" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1node" value="&lt;b&gt;Application error page&lt;/b&gt; [E1, AppErrorBoundary]&lt;br&gt;Reload control and a link to /; a pathname change resets it (NFR-006 AC-3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="480" y="1000" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="list" value="&lt;b&gt;/todos?status=&amp;amp;q=&amp;amp;page=&lt;/b&gt; [RequireAuth, S3]&lt;br&gt;List, filter, search, pagination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="280" width="280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="new" value="&lt;b&gt;/todos/new&lt;/b&gt; [RequireAuth, S4]&lt;br&gt;Add form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="110" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="detail" value="&lt;b&gt;/todos/:id&lt;/b&gt; [RequireAuth, S5]&lt;br&gt;Detail with timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="750" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="edit" value="&lt;b&gt;/todos/:id/edit&lt;/b&gt; [RequireAuth, S6]&lt;br&gt;Edit form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1820" y="750" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="del" value="&lt;b&gt;Delete dialog&lt;/b&gt; [native dialog, D1]&lt;br&gt;Names the to-do; Confirm deletes and the list is re-queried; Cancel changes nothing (sdd §8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1820" y="290" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="clear" value="&lt;b&gt;Clear-completed dialog&lt;/b&gt; [native dialog, D2]&lt;br&gt;Shows N and scope; Confirm deletes all completed and the list is re-queried; Cancel deletes nothing; N = 0: no dialog, control disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1820" y="470" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="signed out,&lt;br&gt;public route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="probe" target="signup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="signed out, to-do route&lt;br&gt;or unknown address" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.166667;entryX=0;entryY=0.333333;" edge="1" parent="1" source="probe" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="signed in: stays;&lt;br&gt;/login and /signup go to /todos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.642857;" edge="1" parent="1" source="probe" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3b" value="signed in,&lt;br&gt;unknown&lt;br&gt;address (*)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.916667;entryX=0;entryY=0.5;" edge="1" parent="1" source="probe" target="nf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="500"/><mxPoint x="360" y="870"/></Array></mxGeometry></mxCell>
        <mxCell id="e3c" value="network error&lt;br&gt;or 500: state&lt;br&gt;stays unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="probe" target="pf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3d" value="Retry: the&lt;br&gt;probe runs&lt;br&gt;again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="pf" target="probe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="201: log in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="signup" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="200: safeReturnTo(returnTo),&lt;br&gt;else /todos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.214286;" edge="1" parent="1" source="login" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="401 while signed in: /login?returnTo=&lt;br&gt;with session-ended message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.071429;entryX=1;entryY=0.166667;" edge="1" parent="1" source="list" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11b" value="Log out (header, any signed-in screen): /login, no message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.357143;entryX=1;entryY=0.833333;" edge="1" parent="1" source="list" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Add a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.214286;exitY=0;entryX=0.214286;entryY=1;" edge="1" parent="1" source="list" target="new"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6b" value="after create:&lt;br&gt;/todos page 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.785714;exitY=1;entryX=0.785714;entryY=0;" edge="1" parent="1" source="new" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Open a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.214286;exitY=1;entryX=0.214286;entryY=0;" edge="1" parent="1" source="list" target="detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Edit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="detail" target="edit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8b" value="Edit link on a row&lt;br&gt;(ux-design §2.2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0.857143;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="list" target="edit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="680"/><mxPoint x="1960" y="680"/></Array></mxGeometry></mxCell>
        <mxCell id="e8c" value="Save valid: back to the detail page&lt;br&gt;(ux-design §2.2, Q41, not frozen)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.571429;entryY=1;" edge="1" parent="1" source="edit" target="detail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1960" y="900"/><mxPoint x="1500" y="900"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="Delete a to-do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.142857;entryX=0;entryY=0.25;" edge="1" parent="1" source="list" target="del"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9b" value="Confirm or Cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.357143;" edge="1" parent="1" source="del" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9c" value="Delete on the detail page (ux-design §2.2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0.142857;exitY=1;entryX=1;entryY=0.75;" edge="1" parent="1" source="detail" target="del"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="960"/><mxPoint x="2150" y="960"/><mxPoint x="2150" y="380"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="Clear completed&lt;br&gt;(after totals re-fetch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.785714;entryX=0;entryY=0.230769;" edge="1" parent="1" source="list" target="clear"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10b" value="Confirm or Cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.538462;entryX=1;entryY=0.928571;" edge="1" parent="1" source="clear" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="root route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.857143;" edge="1" parent="1" source="root" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="685"/><mxPoint x="1260" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="Go to home link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="nf" target="root"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="870"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="error thrown while&lt;br&gt;rendering&lt;br&gt;(AppErrorBoundary)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="anyscreen" target="e1node"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="link to / (resets the boundary,&lt;br&gt;no full page load)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.75;entryY=1;" edge="1" parent="1" source="e1node" target="root"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1050"/></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue box: route and screen (guard in brackets) · Dashed light blue box: route without a screen · Yellow box: modal dialog · Grey box: start or error state · Solid arrow: navigation or event from the frozen sdd, labelled with condition · Dashed arrow: edge taken only from design/ux/ux-design.md §2.2 (not frozen)&lt;br&gt;Signed-out visitor on a to-do route or unknown address is replaced to /login?returnTo=path with no message; after login safeReturnTo gives /todos (sdd §4.2, analyst default 12). Log out goes to /login with no message; the session-ended message applies to any 401 except the probe and logIn (sdd §4.1).&lt;br&gt;Screen ids S1..S7, D1, D2, E1, G1 are from ux-design.md §2. The sdd does not say where Save on edit navigates or where a delete from the detail page lands (ux-design: /todos, Q40), so those edges are dashed or only described here." style="text;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1030" width="900" height="142" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
