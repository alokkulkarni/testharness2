<mxfile host="sdlc-harness">
  <diagram id="seq-clear-completed" name="Sequence clear completed">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1250">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Sequence: clear completed to-dos&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: REQ-TODO-007 AC-1..AC-4, REQ-ISO-001 AC-3, NFR-007; sdd §2, §7, §8; ADR-0009, 0018; todo-api-v1.yaml listTodos, clearCompletedTodos" style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="SPA [browser]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="160" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="Filters + TodoController [auth, common, todo]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="240" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="TodoService + TodoRepository [todo]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="240" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="SQLite file" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1620" y="100" width="160" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="1. GET /api/v1/todos (current URL query): fresh&lt;br&gt;totals before the dialog [HTTP/JSON]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.14;entryX=0.5;entryY=0.14;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="2. 200 TodoPage, totals.completed = N [HTTP/JSON]" style="html=1;fontSize=12;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.195;entryX=0.5;entryY=0.195;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="N of 1 or more: SPA opens ConfirmDialog. N = 1: Delete 1 completed to-do? This deletes your only completed to-do, even if it is not shown. N of 2 or more: Delete all N completed to-dos? Includes any not shown by page, filter or search. Cancel deletes nothing (REQ-TODO-007 AC-1..AC-3; sdd §8)" style="shape=note;fontSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="note0" value="N = 0 (for example cleared in another tab): no dialog opens and no clearCompletedTodos call is made; the control is disabled and the live region announces There are no completed to-dos to clear. (REQ-TODO-007 AC-4; sdd §8)" style="shape=note;fontSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="530" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="3. DELETE /api/v1/todos/completed + cookie +&lt;br&gt;X-Todo-Client: web, after confirm [HTTP/JSON]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7;entryX=0.5;entryY=0.7;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="4. clearCompleted(userId from the CurrentUser&lt;br&gt;principal) [call]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.77;entryX=0.5;entryY=0.77;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. DELETE FROM todos WHERE user_id = ?&lt;br&gt;AND done = 1 [JDBC]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.84;entryX=0.5;entryY=0.84;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="6. 200 ClearCompletedResult {deletedCount};&lt;br&gt;0 when none completed [HTTP/JSON]" style="html=1;fontSize=12;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.91;entryX=0.5;entryY=0.91;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="7. GET /api/v1/todos: re-query the current&lt;br&gt;URL immediately [HTTP/JSON]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.98;entryX=0.5;entryY=0.98;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Boxes at the top are participants (dark blue: container or datastore, light blue: components); vertical dashed line: lifeline. Brackets name the module package (sdd §2).&lt;br&gt;Solid arrow: request or call, numbered; dashed arrow: response; yellow note: user action in the SPA." style="text;fontSize=12;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1150" width="1100" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
