<mxfile host="sdlc-harness">
  <diagram id="seq-clear-completed" name="Sequence clear completed">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Sequence: clear completed to-dos&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec · drawn 2026-11-06 · Traces: REQ-TODO-007 AC-1..AC-4, REQ-ISO-001 AC-3; sdd §7, §8; ADR-0009; contract listTodos, clearCompletedTodos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="SPA [browser]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="Filters + TodoController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="120" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="TodoService + TodoRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="120" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="SQLite file" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1120" y="100" width="120" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="1. GET /api/v1/todos (current URL query): fresh totals before the dialog [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1;entryX=0.5;entryY=0.1;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m1" value="2. 200 TodoPage, totals.completed = N; control disabled when N = 0 [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2;entryX=0.5;entryY=0.2;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="SPA opens ConfirmDialog: Delete all N completed to-dos? Includes any not shown by page, filter or search. Cancel deletes nothing (REQ-TODO-007 AC-1..AC-3)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="200" y="290" width="360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="3. DELETE /api/v1/todos/completed + cookie + X-Todo-Client: web, after confirm [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="4. clearCompleted(userId from the session) [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.6;entryX=0.5;entryY=0.6;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="5. DELETE FROM todos WHERE user_id = ? AND done = 1 [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7;entryX=0.5;entryY=0.7;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="6. 200 ClearCompletedResult {deletedCount}; 0 when none completed [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.8;entryX=0.5;entryY=0.8;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="7. GET /api/v1/todos: re-query the current URL immediately [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.9;entryX=0.5;entryY=0.9;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Boxes at the top are participants (dark blue: container or datastore, light blue: components); vertical dashed line: lifeline.&lt;br&gt;Solid arrow: request or call, numbered; dashed arrow: response; yellow note: user action in the SPA." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="800" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
