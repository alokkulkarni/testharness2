<mxfile host="sdlc-harness">
  <diagram id="seq-signup-login" name="Sequence sign-up and login">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1500">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Sequence: sign-up, login, session cookie and cross-site header defence&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: REQ-AUTH-001, REQ-AUTH-002, REQ-AUTH-003, NFR-004; sdd §2, §4, §5, §6; ADR-0004, 0005, 0007, 0008, 0011, 0015, 0016, 0018; identity-api-v1.yaml signUp, logIn" style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="SPA [browser]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="160" height="1240" as="geometry"/>
        </mxCell>
        <mxCell id="LC" value="Direct API caller [curl, tests]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="305" y="1030" width="170" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="ClientHeaderFilter + AuthController + AuthService + SessionService [auth, common]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="260" height="1240" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="UserRepository + SessionRepository [auth]" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="200" height="1240" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="SQLite file" style="shape=umlLifeline;fontSize=12;spacingLeft=8;spacingRight=8;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="160" height="1240" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="1. POST /api/v1/auth/signup + X-Todo-Client: web [HTTP/JSON]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.0887;entryX=0.5;entryY=0.0887;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="2. header ok, no session needed; trim, validate,&lt;br&gt;Argon2id hash; insert user [call]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1613;entryX=0.5;entryY=0.1613;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="3. INSERT users; UNIQUE(identifier_key) [JDBC]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2258;entryX=0.5;entryY=0.2258;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="4. 201 SignupResult, no session; duplicate&lt;br&gt;gives 409 IDENTIFIER_TAKEN [HTTP/JSON]" style="html=1;fontSize=12;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2903;entryX=0.5;entryY=0.2903;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. POST /api/v1/auth/login + X-Todo-Client: web [HTTP/JSON]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.3629;entryX=0.5;entryY=0.3629;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="6. header ok; find user by trimmed,&lt;br&gt;lower-cased identifier [call]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4274;entryX=0.5;entryY=0.4274;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="7. SELECT users [JDBC]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4919;entryX=0.5;entryY=0.4919;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m8" value="8. verify Argon2id (dummy hash if unknown);&lt;br&gt;store SHA-256 of new token [call]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5645;entryX=0.5;entryY=0.5645;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m9" value="9. INSERT sessions (token_hash, user_id,&lt;br&gt;expires_at = now + 8 h) [JDBC]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.629;entryX=0.5;entryY=0.629;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m10" value="10. 200 Session + Set-Cookie todo_session&lt;br&gt;(HttpOnly, SameSite=Strict, Max-Age=28800);&lt;br&gt;bad credentials: same 401 INVALID_CREDENTIALS,&lt;br&gt;written by ProblemDetailsAdvice [HTTP/JSON]" style="html=1;fontSize=12;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7097;entryX=0.5;entryY=0.7097;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m11" value="11. POST without&lt;br&gt;X-Todo-Client, e.g. curl&lt;br&gt;or a test [HTTP]" style="html=1;fontSize=12;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4516;entryX=0.5;entryY=0.8629;" edge="1" parent="1" source="LC" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m12" value="12. 403 CLIENT_HEADER_MISSING&lt;br&gt;via ProblemWriter; a protected&lt;br&gt;call without a session gets 401&lt;br&gt;first (ADR-0007) [HTTP/JSON]" style="html=1;fontSize=12;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.9355;entryX=0.5;entryY=0.7419;" edge="1" parent="1" source="L2" target="LC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Cross-origin web page: no CORS is configured, so the browser's preflight fails and no request is sent (ADR-0007). The SPA client wrapper always adds X-Todo-Client on unsafe methods (sdd §2), so the SPA never reaches step 12." style="shape=note;fontSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1100" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Boxes at the top are participants (dark blue: container or datastore, light blue: components, grey: a caller outside the app); vertical dashed line: lifeline.&lt;br&gt;Solid arrow: request or call, numbered in order; dashed arrow: response. Labels end with the protocol or mechanism. Yellow note: remark." style="text;fontSize=12;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1390" width="1000" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
