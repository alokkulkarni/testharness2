<mxfile host="sdlc-harness">
  <diagram id="seq-signup-login" name="Sequence sign-up and login">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Sequence: sign-up, login, session cookie and cross-site header defence&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec · drawn 2026-11-06 · Traces: REQ-AUTH-001, REQ-AUTH-002, REQ-AUTH-003, REQ-AUTH-004 AC-1; sdd §4, §5; ADR-0004, 0005, 0007, 0008, 0015, 0016; contract signUp, logIn" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="SPA [browser]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="ClientHeaderFilter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="AuthController + AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="UserRepository + SessionRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="L5" value="SQLite file" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="1. POST /api/v1/auth/signup + X-Todo-Client: web [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.0789;entryX=0.5;entryY=0.0789;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m1" value="2. header ok; no session needed [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1316;entryX=0.5;entryY=0.1316;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="3. trim, validate, Argon2id hash; insert user [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.1842;entryX=0.5;entryY=0.1842;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="4. INSERT users; UNIQUE(identifier_key) [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2368;entryX=0.5;entryY=0.2368;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="5. 201 SignupResult, no session; duplicate gives 409 IDENTIFIER_TAKEN [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.2895;entryX=0.5;entryY=0.2895;" edge="1" parent="1" source="L3" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="6. POST /api/v1/auth/login + X-Todo-Client: web [HTTP/JSON]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.3421;entryX=0.5;entryY=0.3421;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="7. header ok [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.3947;entryX=0.5;entryY=0.3947;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="8. find user by trimmed, lower-cased identifier [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.4474;entryX=0.5;entryY=0.4474;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m8" value="9. SELECT users [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m9" value="10. verify Argon2id (dummy hash if unknown); store SHA-256 of new token [call]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.5526;entryX=0.5;entryY=0.5526;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m10" value="11. INSERT sessions (token_hash, user_id, expires_at = now + 8 h) [JDBC]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.6053;entryX=0.5;entryY=0.6053;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m11" value="12. 200 Session + Set-Cookie todo_session (HttpOnly, SameSite=Strict, Max-Age=28800); bad credentials: same 401 INVALID_CREDENTIALS [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.6579;entryX=0.5;entryY=0.6579;" edge="1" parent="1" source="L3" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m12" value="13. a request without X-Todo-Client (no CORS, so a cross-origin preflight fails first) [HTTP]" style="html=1;endArrow=block;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.7632;entryX=0.5;entryY=0.7632;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m13" value="14. 403 CLIENT_HEADER_MISSING via ProblemWriter; protected calls without a session get 401 first (ADR-0007) [HTTP/JSON]" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;spacingBottom=3;exitX=0.5;exitY=0.8158;entryX=0.5;entryY=0.8158;" edge="1" parent="1" source="L2" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Boxes at the top are participants (dark blue: container or datastore, light blue: components); vertical dashed line: lifeline.&lt;br&gt;Solid arrow: request or call, numbered in order; dashed arrow: response. Labels end with the protocol or mechanism." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="800" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
