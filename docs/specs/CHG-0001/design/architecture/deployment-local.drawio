<mxfile host="sdlc-harness">
  <diagram id="deployment-local" name="Deployment local">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2000" pageHeight="760">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · Deployment view: local run only&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: NFR-002, NFR-005, NFR-007 AC-1, REQ-DATA-001 AC-3; sdd §11, §13; ADR-0001, 0002, 0003, 0013, 0016, 0018" style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="machine" value="Developer or user machine (the only deployment node; no dev, test or cloud environment)" style="rounded=0;dashed=1;fontSize=12;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1900" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;[any current browser]&lt;br&gt;Runs the SPA; holds the todo_session cookie" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="40" y="100" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="vite" value="&lt;b&gt;Vite dev server&lt;/b&gt;&lt;br&gt;[Node.js LTS, pnpm -C web dev, :5173]&lt;br&gt;Serves SPA, proxies /api to :8080" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="600" y="100" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="jvm" value="&lt;b&gt;API process&lt;/b&gt;&lt;br&gt;[JDK 21, ./mvnw spring-boot:run, :8080]&lt;br&gt;One Spring Boot application, identity and to-dos modules, one pool (ADR-0018); Flyway migration at start" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="1120" y="90" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="file" value="&lt;b&gt;todo.db&lt;/b&gt;&lt;br&gt;[SQLite file, TODO_DB_PATH default ./data/todo.db]&lt;br&gt;Created with its directory on first start; api/data/ git-ignored" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="1620" y="70" width="240" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="&lt;b&gt;Settings (.env.example, placeholders only)&lt;/b&gt;&lt;br&gt;TODO_DB_PATH, TODO_COOKIE_SECURE=false, SERVER_PORT=8080. No secrets needed." style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="1120" y="330" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Not deployed (NFR-002)&lt;/b&gt;&lt;br&gt;No cloud service, hosted database, email service, or deployment workflow. Cookie is not Secure on plain HTTP; any hosting would need HTTPS and TODO_COOKIE_SECURE=true (sdd §13).&lt;br&gt;The e2e session-expiry run starts the API through spring-boot:test-run with a test-only clock (ADR-0013); it is not part of the normal run and is not drawn." style="rounded=1;fontSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="machine">
          <mxGeometry x="40" y="300" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Loads SPA, calls /api [HTTP :5173]" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="vite"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Proxies /api/v1/** [HTTP :8080]" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vite" target="jvm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Reads, writes [JDBC]" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jvm" target="file"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Configures [env vars]" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env" target="jvm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue box: runtime process or application; cylinder: file datastore; grey box: configuration; dashed box: deployment node or statement of absence&lt;br&gt;Arrow: call or configuration flow, labelled with verb and protocol" style="text;fontSize=12;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="900" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
