<mxfile host="sdlc-harness">
  <diagram id="c4-component-errors" name="C4 component API error path">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2700" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do list · C4 component view · API error path (problem+json)&lt;/b&gt;&lt;br&gt;CHG-0001 · frozen spec (supersede-2, approved 2026-11-07) · drawn 2026-11-08&lt;br&gt;Traces: NFR-004, NFR-006 AC-2, NFR-007, REQ-AUTH-002 AC-2, REQ-AUTH-004 AC-1; sdd §2, §4, §6, §10; ADR-0004, 0007, 0011, 0018; common-problem-v1.yaml Problem, FieldError" style="text;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="common" value="Shared kernel · app.todo.common (the one error model, ADR-0011)" style="rounded=0;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="1560" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="sessf" value="&lt;b&gt;SessionCookieAuthenticationFilter&lt;/b&gt; [Spring Security, auth]&lt;br&gt;Resolves the session or leaves the request unauthenticated; never writes a response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="mods" value="&lt;b&gt;Controllers and services&lt;/b&gt; [Spring MVC and beans, auth and todo]&lt;br&gt;Throw ApiException subtypes: ValidationException, NotFoundException (common); IdentifierTakenException, InvalidCredentialsException (auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2300" y="140" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="hdrf" value="&lt;b&gt;ClientHeaderFilter&lt;/b&gt; [servlet filter]&lt;br&gt;POST, PUT, DELETE need X-Todo-Client: web (ADR-0007)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="60" y="60" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;ProblemAuthenticationEntryPoint&lt;/b&gt; [Spring Security]&lt;br&gt;401 UNAUTHENTICATED on a protected path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="60" y="270" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="reqid" value="&lt;b&gt;RequestIdFilter&lt;/b&gt; [servlet filter]&lt;br&gt;REQUEST and ERROR dispatches; logs the stack trace when an exception escapes the chain (sdd §10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="60" y="520" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="pw" value="&lt;b&gt;ProblemWriter&lt;/b&gt; [component]&lt;br&gt;Only builder of error bodies: application/problem+json with code and errors[] (ADR-0011)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="640" y="250" width="340" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="errc" value="&lt;b&gt;ProblemErrorController&lt;/b&gt; [Spring MVC]&lt;br&gt;Container /error forwards; no whitelabel page; logs no stack trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="640" y="520" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="advice" value="&lt;b&gt;ProblemDetailsAdvice&lt;/b&gt; [Spring MVC]&lt;br&gt;ApiException subtypes and MVC exceptions: 400, 401 INVALID_CREDENTIALS, 404, 405, 409, 415, 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="1140" y="55" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rej" value="&lt;b&gt;ProblemRequestRejectedHandler&lt;/b&gt; [Spring Security]&lt;br&gt;Firewall rejections: REQUEST_REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="common">
          <mxGeometry x="1140" y="270" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Spring Security invokes it:&lt;br&gt;no session on a&lt;br&gt;protected path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sessf" target="entry"><mxGeometry x="-0.2" relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="writes 403 CLIENT_HEADER_MISSING" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=1;exitY=0.5;entryX=0.25;entryY=0;" edge="1" parent="1" source="hdrf" target="pw"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1345" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="writes 401&lt;br&gt;UNAUTHENTICATED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry" target="pw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="throws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="mods" target="advice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="writes 400, 401&lt;br&gt;INVALID_CREDENTIALS,&lt;br&gt;404, 405, 409, 415, 500" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0;exitY=0.5;entryX=0.75;entryY=0;" edge="1" parent="1" source="advice" target="pw"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="writes&lt;br&gt;REQUEST_REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="rej" target="pw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="writes forwarded 4xx, 5xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="errc" target="pw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="exception escaping the chain:&lt;br&gt;container forwards to /error&lt;br&gt;(500 INTERNAL_ERROR)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="reqid" target="errc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue box: component · Dashed box: shared kernel (common) · Solid arrow: call, labelled with the status or code written · Dashed arrow: not a direct call (a container forward, or Spring Security invoking the entry point).&lt;br&gt;Only ProblemWriter builds an error body, so every error under /api/** has the same shape (ADR-0011). The SPA shows errors[].message only (sdd §6.1). common names no module type (ADR-0018)." style="text;harness=legend;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="1500" height="72" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
