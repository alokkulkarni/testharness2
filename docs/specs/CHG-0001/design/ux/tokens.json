{
  "$description": "CHG-0001 design tokens (W3C Design Tokens format). Two layers: primitives (raw values) and semantic tokens (what a value is for) as references to primitives. UI code uses semantic tokens only. Semantic path color.text.primary maps to CSS custom property --color-text-primary and to Figma variable color/text/primary. Single light theme: the spec requires no dark or high-contrast theme. Contrast ratios in $extensions are computed from the hex values with the WCAG 2.x relative-luminance formula and are to be re-verified by web-qa with a tool (see ux-design.md section 9).",
  "primitive": {
    "color": {
      "white":     { "$value": "#FFFFFF", "$type": "color" },
      "gray": {
        "50":  { "$value": "#F9FAFB", "$type": "color" },
        "200": { "$value": "#E5E7EB", "$type": "color" },
        "500": { "$value": "#6B7280", "$type": "color" },
        "600": { "$value": "#4B5563", "$type": "color" },
        "700": { "$value": "#374151", "$type": "color" },
        "900": { "$value": "#111827", "$type": "color" }
      },
      "blue": {
        "50":  { "$value": "#EFF6FF", "$type": "color" },
        "700": { "$value": "#1D4ED8", "$type": "color" },
        "800": { "$value": "#1E40AF", "$type": "color" }
      },
      "red": {
        "50":  { "$value": "#FEF2F2", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" },
        "800": { "$value": "#991B1B", "$type": "color" }
      },
      "green": {
        "50":  { "$value": "#F0FDF4", "$type": "color" },
        "800": { "$value": "#166534", "$type": "color" }
      },
      "amber": {
        "800": { "$value": "#92400E", "$type": "color" }
      }
    },
    "space": {
      "1":  { "$value": "4px",  "$type": "dimension" },
      "2":  { "$value": "8px",  "$type": "dimension" },
      "3":  { "$value": "12px", "$type": "dimension" },
      "4":  { "$value": "16px", "$type": "dimension" },
      "6":  { "$value": "24px", "$type": "dimension" },
      "8":  { "$value": "32px", "$type": "dimension" },
      "12": { "$value": "48px", "$type": "dimension" }
    },
    "font": {
      "family": {
        "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$type": "fontFamily" }
      },
      "weight": {
        "regular": { "$value": 400, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold": { "$value": 700, "$type": "fontWeight" }
      },
      "size": {
        "sm":  { "$value": "0.875rem", "$type": "dimension" },
        "md":  { "$value": "1rem",     "$type": "dimension" },
        "lg":  { "$value": "1.25rem",  "$type": "dimension" },
        "xl":  { "$value": "1.75rem",  "$type": "dimension" }
      },
      "lineHeight": {
        "tight":  { "$value": 1.3, "$type": "number" },
        "normal": { "$value": 1.5, "$type": "number" }
      }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension" },
      "md": { "$value": "8px", "$type": "dimension" }
    },
    "border": {
      "width": {
        "thin":  { "$value": "1px", "$type": "dimension" },
        "thick": { "$value": "2px", "$type": "dimension" }
      }
    },
    "duration": {
      "none": { "$value": "0ms",   "$type": "duration" },
      "fast": { "$value": "120ms", "$type": "duration" },
      "notFound": { "$value": "600ms", "$type": "duration" },
      "notFoundCeiling": { "$value": "5000ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" }
    }
  },
  "color": {
    "$description": "Semantic colours. Text pairs target 4.5:1 (AA) or better; non-text pairs (borders of inputs, focus ring) target 3:1 or better.",
    "surface": {
      "page":    { "$value": "{primitive.color.gray.50}", "$type": "color", "$description": "Page background" },
      "default": { "$value": "{primitive.color.white}",   "$type": "color", "$description": "Cards, rows, form fields, dialogs" },
      "muted":   { "$value": "{primitive.color.gray.200}", "$type": "color", "$description": "Disabled control background" },
      "info":    { "$value": "{primitive.color.blue.50}",  "$type": "color", "$description": "Informational message background (account created, session ended)" },
      "danger":  { "$value": "{primitive.color.red.50}",   "$type": "color", "$description": "Error message and error summary background" },
      "success": { "$value": "{primitive.color.green.50}", "$type": "color", "$description": "Success message background (status confirmations)" }
    },
    "text": {
      "primary":   { "$value": "{primitive.color.gray.900}", "$type": "color", "$extensions": { "contrast": { "on:surface.default": "17.7:1", "on:surface.page": "16.9:1" } } },
      "secondary": { "$value": "{primitive.color.gray.600}", "$type": "color", "$extensions": { "contrast": { "on:surface.default": "7.6:1", "on:surface.page": "7.2:1" } } },
      "link":      { "$value": "{primitive.color.blue.700}", "$type": "color", "$extensions": { "contrast": { "on:surface.default": "6.7:1", "on:surface.page": "6.4:1", "on:surface.info": "6.1:1" } } },
      "linkHover": { "$value": "{primitive.color.blue.800}", "$type": "color" },
      "onAction":  { "$value": "{primitive.color.white}",    "$type": "color", "$extensions": { "contrast": { "on:action.primary": "6.7:1", "on:action.danger": "6.5:1" } } },
      "danger":    { "$value": "{primitive.color.red.700}",  "$type": "color", "$extensions": { "contrast": { "on:surface.default": "6.5:1", "on:surface.danger": "6.0:1" } } },
      "success":   { "$value": "{primitive.color.green.800}","$type": "color", "$extensions": { "contrast": { "on:surface.default": "7.1:1", "on:surface.success": "6.7:1" } } },
      "disabled":  { "$value": "{primitive.color.gray.500}", "$type": "color", "$description": "Disabled controls only; WCAG 1.4.3 exempts inactive components" },
      "priority": {
        "low":    { "$value": "{primitive.color.gray.700}",  "$type": "color", "$extensions": { "contrast": { "on:surface.default": "10.3:1" } } },
        "medium": { "$value": "{primitive.color.amber.800}", "$type": "color", "$extensions": { "contrast": { "on:surface.default": "7.1:1" } } },
        "high":   { "$value": "{primitive.color.red.700}",   "$type": "color", "$extensions": { "contrast": { "on:surface.default": "6.5:1" } } }
      }
    },
    "action": {
      "primary":      { "$value": "{primitive.color.blue.700}", "$type": "color" },
      "primaryHover": { "$value": "{primitive.color.blue.800}", "$type": "color" },
      "danger":       { "$value": "{primitive.color.red.700}",  "$type": "color" },
      "dangerHover":  { "$value": "{primitive.color.red.800}",  "$type": "color" }
    },
    "border": {
      "default": { "$value": "{primitive.color.gray.500}", "$type": "color", "$description": "Input, select, checkbox and secondary-button borders (non-text, 4.8:1 on white, needs 3:1)" },
      "subtle":  { "$value": "{primitive.color.gray.200}", "$type": "color", "$description": "Decorative dividers between rows only; never the sole boundary of a control" },
      "danger":  { "$value": "{primitive.color.red.700}",  "$type": "color", "$description": "Input in error (always together with the visible \"Error:\" text message, never colour alone)" }
    },
    "focus": {
      "ring": { "$value": "{primitive.color.blue.700}", "$type": "color", "$extensions": { "contrast": { "on:surface.default": "6.7:1", "on:surface.page": "6.4:1", "on:surface.info": "6.1:1", "on:surface.danger": "5.9:1" } } }
    }
  },
  "space": {
    "$description": "4px base scale. inset = padding inside a component; stack = vertical gap between siblings; inline = horizontal gap.",
    "inset": {
      "sm": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "md": { "$value": "{primitive.space.4}", "$type": "dimension" },
      "lg": { "$value": "{primitive.space.6}", "$type": "dimension" }
    },
    "stack": {
      "xs": { "$value": "{primitive.space.1}", "$type": "dimension" },
      "sm": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "md": { "$value": "{primitive.space.4}", "$type": "dimension" },
      "lg": { "$value": "{primitive.space.8}", "$type": "dimension" }
    },
    "inline": {
      "sm": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "md": { "$value": "{primitive.space.4}", "$type": "dimension" }
    }
  },
  "size": {
    "target": {
      "min":     { "$value": "44px", "$type": "dimension", "$description": "Minimum interactive target height/width in this design; a design target beyond the audited level (WCAG 2.1 AA has no minimum target size)" },
      "wcagMin": { "$value": "24px", "$type": "dimension", "$description": "WCAG 2.2 criterion 2.5.8 floor, recorded as informational (ux-design.md section 9.2); not part of the NFR-001 audit level" }
    },
    "content": {
      "maxWidth": { "$value": "720px", "$type": "dimension" },
      "authMaxWidth": { "$value": "420px", "$type": "dimension" },
      "dialogMaxWidth": { "$value": "480px", "$type": "dimension" }
    },
    "breakpoint": {
      "min":    { "$value": "320px", "$type": "dimension", "$description": "Narrowest supported viewport (1.4.10 Reflow); no horizontal scroll" },
      "medium": { "$value": "640px", "$type": "dimension", "$description": "Row meta moves from stacked to inline at and above this width" }
    }
  },
  "typography": {
    "body":    { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.regular}",  "fontSize": "{primitive.font.size.md}", "lineHeight": "{primitive.font.lineHeight.normal}" } },
    "small":   { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.regular}",  "fontSize": "{primitive.font.size.sm}", "lineHeight": "{primitive.font.lineHeight.normal}" } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.semibold}", "fontSize": "{primitive.font.size.md}", "lineHeight": "{primitive.font.lineHeight.normal}" } },
    "heading2":{ "$type": "typography", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.bold}",     "fontSize": "{primitive.font.size.lg}", "lineHeight": "{primitive.font.lineHeight.tight}" } },
    "heading1":{ "$type": "typography", "$value": { "fontFamily": "{primitive.font.family.sans}", "fontWeight": "{primitive.font.weight.bold}",     "fontSize": "{primitive.font.size.xl}", "lineHeight": "{primitive.font.lineHeight.tight}" } }
  },
  "radius": {
    "control": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
    "surface": { "$value": "{primitive.radius.md}", "$type": "dimension" }
  },
  "border": {
    "width": {
      "default": { "$value": "{primitive.border.width.thin}",  "$type": "dimension" }
    }
  },
  "focus": {
    "width":  { "$value": "{primitive.border.width.thick}", "$type": "dimension", "$description": "Focus indicator thickness (2.4.13 asks for at least 2px perimeter equivalent at AAA; 2px is used throughout)" },
    "offset": { "$value": "2px", "$type": "dimension", "$description": "Gap between control edge and ring, so the ring is not clipped or hidden by the control (2.4.11)" }
  },
  "elevation": {
    "dialog": { "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, "$type": "shadow", "$description": "Dialog only. Backdrop colour for ::backdrop is rgba(17,24,39,0.6)." }
  },
  "motion": {
    "$description": "The only decorative animation is the not-found page illustration (REQ-NAV-001 AC-6; ux-design.md section 7.2). Other transitions take motion.default. Under prefers-reduced-motion: reduce every duration is motion.reduced (0ms) and the illustration is drawn in its end state.",
    "default": { "$value": "{primitive.duration.fast}", "$type": "duration" },
    "reduced": { "$value": "{primitive.duration.none}", "$type": "duration" },
    "notFound": {
      "$description": "Not-found illustration: enter (fade and rise) then strike, each once. The strike starts when the enter ends (delay 600ms), so the total is 1200ms; ceiling 5000ms (WCAG 2.2.2); iteration count 1; opacity and transform only, no flashing (2.3.1).",
      "enter":      { "duration": { "$value": "{primitive.duration.notFound}", "$type": "duration" }, "easing": { "$value": "{primitive.easing.standard}", "$type": "cubicBezier" } },
      "strike":     { "duration": { "$value": "{primitive.duration.notFound}", "$type": "duration" }, "delay": { "$value": "{primitive.duration.notFound}", "$type": "duration" }, "easing": { "$value": "{primitive.easing.standard}", "$type": "cubicBezier" } },
      "iterations": { "$value": 1, "$type": "number" },
      "maxTotal":   { "$value": "{primitive.duration.notFoundCeiling}", "$type": "duration" }
    }
  }
}
