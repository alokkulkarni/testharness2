        <mxCell id="e0" value="Registers before security chain [FilterRegistrationBean]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="webcfg" target="reqid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
