          <mxGeometry x="860" y="40" width="380" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="seccfg" value="&lt;b&gt;SecurityConfig&lt;/b&gt; [config]&lt;br&gt;Stateless filter chain, 401 entry point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="col1">
          <mxGeometry x="60" y="50" width="260" height="70" as="geometry"/>
        </mxCell>
