        </mxCell>
        <mxCell id="apib" value="API [Spring Boot, root package app.todo] - one process, one deployable" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;container=1;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
