        <mxCell id="urepo" value="&lt;b&gt;UserRepository&lt;/b&gt;&lt;br&gt;[package-private, JDBC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="col2">
          <mxGeometry x="580" y="410" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="tctl" value="&lt;b&gt;TodoController&lt;/b&gt; [Spring MVC]&lt;br&gt;Seven to-do operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="col3">
          <mxGeometry x="40" y="140" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="tsvc" value="&lt;b&gt;TodoService, TodoValidator&lt;/b&gt;&lt;br&gt;Validate, then owner-scoped work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="col3">
          <mxGeometry x="40" y="230" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="trepo" value="&lt;b&gt;TodoRepository&lt;/b&gt; [package-private]&lt;br&gt;Every method takes userId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="col3">
          <mxGeometry x="40" y="320" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite file&lt;/b&gt; [SQLite]&lt;br&gt;users, sessions, todos, flyway_schema_history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="1560" height="90" as="geometry"/>
