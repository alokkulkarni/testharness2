          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4b" value="Reads principal [@AuthenticationPrincipal]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="tctl" target="cu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4c" value="Resolves session [in-process]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="filt" target="ssvc">
