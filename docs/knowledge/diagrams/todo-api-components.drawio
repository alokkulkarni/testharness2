          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Registers after authorization [filter chain]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="seccfg" target="hdr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Writes 403 [problem+json]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="hdr" target="prob">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
