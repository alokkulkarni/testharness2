        <mxCell id="e11" value="Reads and writes sessions [JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.3718;entryY=0;" edge="1" parent="1" source="srepo" target="db">
