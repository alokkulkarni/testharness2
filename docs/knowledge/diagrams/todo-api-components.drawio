        </mxCell>
        <mxCell id="dbcfg" value="&lt;b&gt;DatabaseConfig&lt;/b&gt; [config]&lt;br&gt;The only DataSource, pool of 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;" vertex="1" parent="col1">
          <mxGeometry x="60" y="380" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="filt" value="&lt;b&gt;SessionCookieAuthenticationFilter&lt;/b&gt;&lt;br&gt;Cookie to CurrentUser principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="col2">
          <mxGeometry x="60" y="50" width="260" height="70" as="geometry"/>
        </mxCell>
