        <mxCell id="e12" value="Reads and writes todos [JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.8846;entryY=0;" edge="1" parent="1" source="trepo" target="db">
