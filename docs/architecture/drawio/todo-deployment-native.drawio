<mxfile host="sdlc-harness">
  <diagram id="todo-deployment-native" name="Deployment native run">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do app · Deployment view: native run (as built by CHG-0001)&lt;/b&gt;&lt;br&gt;CHG-0005 · 2026-11-13&lt;br&gt;Green: documentation CHG-0005 adds. Nothing else in this view changes." style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="800" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="machine" value="Developer machine (the only deployment node; no dev, test or cloud environment)" style="rounded=0;dashed=1;fontSize=12;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1440" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;[any current browser]&lt;br&gt;Runs the SPA; keeps the todo_session cookie" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="40" y="80" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="vite" value="&lt;b&gt;Vite dev server&lt;/b&gt;&lt;br&gt;[Node.js LTS, pnpm -C web dev, :5173]&lt;br&gt;Serves the SPA; proxies /api to localhost:8080" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="380" y="70" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API process&lt;/b&gt;&lt;br&gt;[JDK 21, ./mvnw spring-boot:run, :8080]&lt;br&gt;One Spring Boot application, one pool; creates the database directory and runs the Flyway migration at start" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="760" y="60" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="file" value="&lt;b&gt;todo.db&lt;/b&gt;&lt;br&gt;[SQLite file, TODO_DB_PATH, default ./data/todo.db]&lt;br&gt;api/data/ is git-ignored" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="1180" y="60" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="docs" value="&lt;b&gt;README.md and .env.example&lt;/b&gt;&lt;br&gt;[repository root; placeholders only]&lt;br&gt;Run steps; TODO_DB_PATH, TODO_COOKIE_SECURE=false, SERVER_PORT=8080 exported in the shell (nothing loads a .env file)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="740" y="290" width="320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e2e" value="&lt;b&gt;Playwright e2e&lt;/b&gt;&lt;br&gt;[pnpm -C web e2e]&lt;br&gt;Starts its own API and SPA on a temporary database, so ports 8080 and 5173 must be free" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="360" y="290" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Not deployed (CHG-0001 NFR-002)&lt;/b&gt;&lt;br&gt;No cloud service, hosted database, email service or deployment workflow. The cookie is not Secure on plain http; any hosting would need HTTPS and TODO_COOKIE_SECURE=true. The session-expiry e2e uses a test-only clock (ADR-0013) and is not part of the normal run." style="rounded=1;fontSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="machine">
          <mxGeometry x="40" y="460" width="1360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Loads SPA, calls /api&lt;br&gt;[HTTP :5173]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="vite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Proxies /api/v1/**&lt;br&gt;[HTTP :8080]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vite" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Reads, writes&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="file">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Documents settings&lt;br&gt;[env vars]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="docs" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Drives browsers against&lt;br&gt;[HTTP :5173]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="e2e" target="vite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Arrow: call or configuration flow, labelled verb [protocol] · dashed box: deployment node or statement of absence" style="rounded=0;fontSize=12;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;harness=legend;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="1320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="Person" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="10" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="System or container" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="190" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="Datastore" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="370" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="New (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="550" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg5" value="Changed (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#F9A825;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="730" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg6" value="Removed" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#C62828;dashed=1;opacity=50;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="910" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg7" value="External or tool" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="1090" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
