<mxfile host="sdlc-harness">
  <diagram id="todo-deployment-compose" name="Deployment Docker Compose">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do app · Deployment view: Docker Compose stack (target of CHG-0005, not yet built)&lt;/b&gt;&lt;br&gt;CHG-0005 · 2026-11-13&lt;br&gt;Green: added by CHG-0005. Everything in this view is new except the browser, the host shell and the API process itself." style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="900" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="machine" value="Developer machine (Docker Engine with Compose; the only deployment node; no registry, no cloud)" style="rounded=0;dashed=1;fontSize=12;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1500" height="870" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;[any current browser]&lt;br&gt;Keeps the todo_session cookie" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="40" y="235" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="&lt;b&gt;Smoke-check script&lt;/b&gt;&lt;br&gt;[Node.js, run on the host]&lt;br&gt;No credentials, no data created" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="40" y="365" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="curl" value="&lt;b&gt;Host shell (curl)&lt;/b&gt;&lt;br&gt;[debugging by the person]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="820" y="40" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="net" value="Compose project network (default bridge network of the project)" style="rounded=0;dashed=1;fontSize=12;fillColor=none;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="machine">
          <mxGeometry x="360" y="140" width="800" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;web container&lt;/b&gt;&lt;br&gt;[nginx:stable-alpine, non-root; image from web/Dockerfile]&lt;br&gt;Serves the SPA production build (pnpm build); reverse-proxies /api to the api service; publishes 127.0.0.1:5173. Starts only when api is healthy (depends_on: service_healthy)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="net">
          <mxGeometry x="40" y="80" width="260" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;api container&lt;/b&gt;&lt;br&gt;[eclipse-temurin 21 JRE on Ubuntu, non-root; image from api/Dockerfile]&lt;br&gt;The CHG-0001 Spring Boot API, unchanged. Settings as literals in docker-compose.yml: TODO_DB_PATH inside the volume directory, TODO_COOKIE_SECURE=false, SERVER_PORT=8080. Publishes 127.0.0.1:8080" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="net">
          <mxGeometry x="460" y="100" width="260" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="health" value="&lt;b&gt;Compose healthcheck&lt;/b&gt;&lt;br&gt;[probe in the api container]&lt;br&gt;An existing endpoint; 401 counts as up" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="net">
          <mxGeometry x="460" y="410" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="vol" value="&lt;b&gt;Named volume&lt;/b&gt;&lt;br&gt;[SQLite file todo.db]&lt;br&gt;Survives down; removed by down -v" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="machine">
          <mxGeometry x="1280" y="280" width="160" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;Build time only (nothing is published)&lt;/b&gt;&lt;br&gt;docker compose up builds both images for the machine's own architecture from official multi-arch base images. A docker buildx build for linux/amd64 and linux/arm64 with no push or load proves both build. Logs: each container's stdout (docker compose logs)." style="rounded=1;fontSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="machine">
          <mxGeometry x="40" y="730" width="700" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="notdep" value="&lt;b&gt;Not deployed (CHG-0001 NFR-002)&lt;/b&gt;&lt;br&gt;No cloud service, registry, HTTPS or certificate. The stack is for plain http on localhost; any hosting would need HTTPS and TODO_COOKIE_SECURE=true. Playwright is not run against this stack." style="rounded=1;fontSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="machine">
          <mxGeometry x="780" y="730" width="660" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Opens the SPA, calls /api&lt;br&gt;[HTTP 127.0.0.1:5173]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="browser" target="web">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Requests / and /api/v1/todos&lt;br&gt;[HTTP 127.0.0.1:5173]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="smoke" target="web">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Proxies /api&lt;br&gt;[HTTP api:8080]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Reads, writes&lt;br&gt;[JDBC, file on volume]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="vol">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Probes, 401 = up&lt;br&gt;[HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="health" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="Debug calls&lt;br&gt;[HTTP 127.0.0.1:8080]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="curl" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Arrow: call or data flow, labelled verb [protocol] · dashed box: deployment node, network or statement of absence · green border: new in CHG-0005" style="rounded=0;fontSize=12;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;harness=legend;" vertex="1" parent="1">
          <mxGeometry x="20" y="1010" width="1320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="Person" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="10" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="System or container" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="190" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="Datastore" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="370" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="New (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="550" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg5" value="Changed (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#F9A825;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="730" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg6" value="Removed" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#C62828;dashed=1;opacity=50;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="910" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg7" value="External or tool" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="1090" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
