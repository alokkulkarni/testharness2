<mxfile host="sdlc-harness">
  <diagram id="todo-containers" name="C4 container">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2000" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;To-do app · C4 container view (deployment-neutral)&lt;/b&gt;&lt;br&gt;CHG-0005 · 2026-11-13&lt;br&gt;Native-run and Compose placement of these containers: see the two deployment views" style="text;fontSize=12;harness=title;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Uses the to-do app in a browser" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="To-do app (software system) · one machine only" style="rounded=0;dashed=1;fontSize=12;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="1480" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;SPA&lt;/b&gt; [React, TypeScript, Vite; web/]&lt;br&gt;Runs in the browser: screens, mirror validation, routing, session state (ADR-0001)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="40" y="120" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="&lt;b&gt;SPA web host and /api proxy&lt;/b&gt;&lt;br&gt;[Vite dev server (native run) or nginx (Compose) :5173]&lt;br&gt;Serves the SPA and forwards /api, so one origin" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#F9A825;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="420" y="120" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt; [Java 21, Spring Boot; api/, :8080]&lt;br&gt;Modular monolith: identity and to-dos modules over a shared kernel; one process, one pool. Sessions, validation, problem+json errors (ADR-0002, 0009, 0011, 0018)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="800" y="105" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite file&lt;/b&gt;&lt;br&gt;[WAL; TODO_DB_PATH]&lt;br&gt;users, sessions, todos (ADR-0003, 0014)" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="1240" y="100" width="190" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="&lt;b&gt;Smoke-check script&lt;/b&gt;&lt;br&gt;[Node.js; web/scripts]&lt;br&gt;Checks the SPA page and /api through the host" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="420" y="330" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="logs" value="&lt;b&gt;API log stream&lt;/b&gt;&lt;br&gt;[stdout, JSON (logstash format)]&lt;br&gt;One line per request, with a request id" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="boundary">
          <mxGeometry x="820" y="330" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Uses&lt;br&gt;[HTTP, browser]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="spa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Loads page,&lt;br&gt;calls /api/v1/**&lt;br&gt;[HTTP/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="spa" target="host">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Forwards /api&lt;br&gt;[HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="host" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Reads, writes&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Requests / and /api/v1/todos&lt;br&gt;[HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="smoke" target="host">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="Writes request logs&lt;br&gt;[stdout]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="logs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Arrow: call or data flow, labelled verb [protocol] · dashed box: system boundary · yellow border: changed by CHG-0005 (a second web host), green border: new in CHG-0005" style="rounded=0;fontSize=12;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;harness=legend;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="1320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="Person" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="10" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="System or container" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="190" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="Datastore" style="shape=cylinder3;fontSize=12;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="370" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="New (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E7D32;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="550" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg5" value="Changed (CHG-0005)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#F9A825;strokeWidth=3;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="730" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg6" value="Removed" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#C62828;dashed=1;opacity=50;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="910" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lg7" value="External or tool" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="legend">
          <mxGeometry x="1090" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
